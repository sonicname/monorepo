# Web app dev server port
WEB_PORT=5173

# Optional explicit public origin for the web app
WEB_URL=http://127.0.0.1:5173

# API origin used by the SSR loader and Vite proxy
API_URL=http://127.0.0.1:3001

# Optional fallback port if API_URL is omitted
API_PORT=3001

# Public API base path used by the shared config helpers
PUBLIC_API_BASE_PATH=/api

# Enable BullMQ by either setting REDIS_URL or forcing the feature flag
BULLMQ_ENABLED=true

# Redis connection used by the shared BullMQ helpers
REDIS_URL=redis://127.0.0.1:6379

# Optional BullMQ naming overrides
BULLMQ_PREFIX=monorepo
