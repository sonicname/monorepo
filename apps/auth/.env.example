# Auth service port
AUTH_PORT=3002

# PostgreSQL connection used by the shared Drizzle database package
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/monorepo

# Secret used to sign and verify JWTs — must match across all services that verify tokens
# Generate a strong random value in production: openssl rand -hex 32
JWT_SECRET=change-me-in-production
