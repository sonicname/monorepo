# Auth service port
AUTH_PORT=3002

# PostgreSQL connection for the auth service (database: monorepo_auth)
AUTH_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/monorepo_auth

# Secret used to sign and verify JWTs — must match across all services that verify tokens
# Generate a strong random value in production: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# gRPC server port — consumed by apps/api
AUTH_GRPC_PORT=5001
