# API server port. The shared config also respects PORT as a fallback.
API_PORT=3001

# Optional explicit public origin for the API app
API_URL=http://127.0.0.1:3001

# Web origin allowed by Nest CORS
WEB_URL=http://127.0.0.1:5173

# Shared public API base path used by the web app and config helpers
PUBLIC_API_BASE_PATH=/api

# Enable BullMQ by either setting REDIS_URL or forcing the feature flag
BULLMQ_ENABLED=true

# Redis connection used by the shared BullMQ helpers
REDIS_URL=redis://127.0.0.1:6379

# Optional BullMQ naming overrides
BULLMQ_PREFIX=monorepo
