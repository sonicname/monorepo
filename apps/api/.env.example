# API server port. The shared config also respects PORT as a fallback.
API_PORT=3001

# Optional explicit public origin for the API app
API_URL=http://127.0.0.1:3001

# Web origin allowed by Nest CORS
WEB_URL=http://127.0.0.1:5173

# Shared public API base path used by the web app and config helpers
PUBLIC_API_BASE_PATH=/api

# PostgreSQL connection for the api service (database: monorepo_api)
API_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/monorepo_api

# Enable BullMQ by either setting REDIS_URL or forcing the feature flag
BULLMQ_ENABLED=true

# Redis connection used by the shared BullMQ helpers
REDIS_URL=redis://127.0.0.1:6379

# Enable RabbitMQ by either setting RABBITMQ_URL or forcing the feature flag
RABBITMQ_ENABLED=true

# RabbitMQ connection used by the shared queues package
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# Optional BullMQ naming overrides
BULLMQ_PREFIX=monorepo

# gRPC URL of the auth service
AUTH_GRPC_URL=127.0.0.1:5001

# Enable MongoDB by setting MONGO_URL or the feature flag
MONGO_ENABLED=true

# MongoDB connection URL
MONGO_URL=mongodb://127.0.0.1:27017/monorepo
