{
  "name": "@monorepo/queues",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bullmq": {
      "types": "./dist/bullmq/index.d.ts",
      "default": "./dist/bullmq/index.js"
    },
    "./rabbitmq": {
      "types": "./dist/rabbitmq/index.d.ts",
      "default": "./dist/rabbitmq/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@monorepo/config": "workspace:*",
    "@monorepo/constants": "workspace:*",
    "amqplib": "^0.10.8",
    "bullmq": "^5.56.7"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist"
  ]
}
