<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f4f4f5">
  <table width="100%" cellpadding="0" cellspacing="0" style="padding:32px 0">
    <tr><td align="center">
      <table width="560" cellpadding="0" cellspacing="0" style="background:#fff;border-radius:8px;padding:40px;border:1px solid #e4e4e7">
        <tr><td style="font-size:20px;font-weight:600;color:#18181b;padding-bottom:24px">{{appName}}</td></tr>
        <tr><td style="font-size:15px;line-height:1.6;color:#3f3f46">{{{body}}}</td></tr>
        <tr><td style="padding-top:32px;font-size:12px;color:#a1a1aa">This is an automated email from {{appName}}. Please do not reply.</td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
