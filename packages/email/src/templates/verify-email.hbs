<p>Hi <strong>{{username}}</strong>,</p>
<p>Thanks for signing up! Please verify your email address using the code below:</p>
<div style="margin:16px 0;padding:16px;background:#f4f4f5;border-radius:6px;font-family:monospace;font-size:16px;text-align:center;letter-spacing:1px;color:#18181b">{{token}}</div>
{{#if verifyUrl}}
<p><a href="{{verifyUrl}}" style="display:inline-block;padding:12px 24px;background:#18181b;color:#fff;text-decoration:none;border-radius:6px;font-weight:500">Verify Email</a></p>
{{/if}}
<p>This code expires in <strong>{{expiryHours}} hour(s)</strong>.</p>
